# Postgres
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ledgerflow

# Backend
# Full DB URL used by the API container; docker-compose.yml builds this from the
# POSTGRES_* vars above for local dev. Override directly in production.
DATABASE_URL=postgresql+psycopg://ledgerflow:change_me@db:5432/ledgerflow

JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173

# Seeded on first startup if no users exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Frontend (build-time)
VITE_API_BASE_URL=http://localhost:8000/api/v1
